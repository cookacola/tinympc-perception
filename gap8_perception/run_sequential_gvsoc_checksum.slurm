#!/usr/bin/env bash
#SBATCH --job-name=gap8_sequential_gvsoc
#SBATCH --cpus-per-task=2
#SBATCH --mem=8G
#SBATCH --time=06:00:00
#SBATCH --output=/home/cchen/isaacsim-workspace/workspace/logs/%x-%j.out
#SBATCH --error=/home/cchen/isaacsim-workspace/workspace/logs/%x-%j.err

# Execute the DORY-generated sequential student's checksum harness in GVSOC.
# The application must have been generated by validate_dory_frontend.py with
# --app-dir, which embeds the NEMO integer input and each DORY layer checksum.
set -euo pipefail

: "${EXPORT:?set EXPORT to the completed sequential NEMO export directory}"
GAP_SDK=${GAP_SDK:-/home/cchen/gap_sdk_dory}
GAP_TOOLCHAIN=${GAP_TOOLCHAIN:-/home/cchen/gap_riscv_toolchain_ubuntu_18}
# Accept either the historical export root (containing gap8_application) or
# an explicitly named generated application directory such as
# gap8_application_64.
if test -f "$EXPORT/Makefile"; then
    APP="$EXPORT"
else
    APP="$EXPORT/gap8_application"
fi
LOG="$APP/gvsoc_checksum.log"
CORE=${CORE:-8}
GVSOC_TIMEOUT_S=${GVSOC_TIMEOUT_S:-120}

test -f "$APP/Makefile"
test -f "$APP/src/gap8_checksum_input.c"

source /home/cchen/miniconda3/etc/profile.d/conda.sh
conda activate frontnet
export PATH="$GAP_TOOLCHAIN/bin:$GAP_SDK/install/workstation/bin:$PATH"
export GAP_RISCV_GCC_TOOLCHAIN="$GAP_TOOLCHAIN"
export GAP_RISCV_GCC_TOOLCHAIN_BASE=""
export PKG_CONFIG_PATH="$CONDA_PREFIX/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
export BOARD_NAME=${BOARD_NAME:-gapuino}
set +u
source "$GAP_SDK/configs/gap8_v2.sh"
set -u

cd "$APP"
# Use the SDK's canonical GVSOC execution path. It supplies the executable to
# GAPY explicitly; launching gvsoc_launcher from a prepared config alone can
# leave the simulator running without booting this application.
BUILD_EXT="core${CORE}"
make build_dir_ext="$BUILD_EXT" CORE="$CORE" build image
BUILD_DIR="BUILD${BUILD_EXT}/GAP8_V2/GCC_RISCV"
test -x "$BUILD_DIR/main"
cd "$BUILD_DIR"
timeout --signal=TERM "$GVSOC_TIMEOUT_S" \
  gapy --target=gapuino_v2 --platform=gvsoc --work-dir="$PWD" \
    run --exec-prepare --exec --binary="$PWD/main" 2>&1 | tee "$LOG"
grep -q "Checking final layer: Checksum OK" "$LOG"
