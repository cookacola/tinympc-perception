     def add_data_layout(self):
         print("\nNEMO Frontend: Adding Data Layout.")
         for i, node in enumerate(self.DORY_Graph):
+            # Pooling nodes have no weights. Keep the sentinel local to each
+            # node so a preceding convolution's constant name cannot leak
+            # into a GlobalAveragePool/AveragePool node (or be undefined when
+            # pooling is the first mapped node in a split deployment graph).
+            weights_name = None
             for name in node.constant_names:
                 if name not in ["l","k","outshift","outmul", "inmul1", "inmul2"]:
                     if "bias" not in name:
                         weights_name = name
-            if weights_name in node.__dict__:
+            if weights_name is not None and weights_name in node.__dict__:
                 if node.name in "FullyConnected":
                     if node.__dict__[weights_name]["value"].shape[0] == node.input_channels:
                         node.__dict__[weights_name]["layout"] = "CinCout"
